import("//build/config/features.gni")
import("//build/config/ui.gni")
import("//services/device/public/cpp/geolocation/buildflags.gni")

# Separate target for switches to avoid circular deps (ui -> abp -> ui).
source_set("switches") {
  sources = [
    "abp_switches.cc",
    "abp_switches.h",
  ]
}

source_set("abp") {
  sources = [
    "abp_action_context.cc",
    "abp_action_context.h",
    "abp_config.cc",
    "abp_config.h",
    "abp_console_capture.cc",
    "abp_console_capture.h",
    "abp_controller.cc",
    "abp_controller.h",
    "abp_curl_handler.cc",
    "abp_curl_handler.h",
    "abp_input_dispatcher.cc",
    "abp_input_dispatcher.h",
    "abp_input_mode_icon_view.cc",
    "abp_input_mode_icon_view.h",
    "abp_location_provider.cc",
    "abp_location_provider.h",
    "abp_login_delegate.cc",
    "abp_login_delegate.h",
    "abp_types.cc",
    "abp_types.h",
    "abp_download_observer.cc",
    "abp_download_observer.h",
    "abp_event_collector.cc",
    "abp_event_collector.h",
    "abp_event_observer.cc",
    "abp_event_observer.h",
    "abp_history_controller.cc",
    "abp_history_controller.h",
    "abp_history_database.cc",
    "abp_history_database.h",
    "abp_http_server.cc",
    "abp_http_server.h",
    "abp_mcp_handler.cc",
    "abp_mcp_handler.h",
    "abp_network_capture.cc",
    "abp_network_capture.h",
    "abp_network_database.cc",
    "abp_network_database.h",
    "abp_permission_observer.cc",
    "abp_permission_observer.h",
    "abp_popup_interceptor.cc",
    "abp_popup_interceptor.h",
    "abp_tool_builder.cc",
    "abp_tool_builder.h",
  ]

  if (os_level_geolocation_permission_supported) {
    sources += [
      "abp_system_geolocation_source.cc",
      "abp_system_geolocation_source.h",
    ]
  }

  deps = [
    ":switches",
    "//base",
    "//chrome/app/vector_icons",
    "//chrome/browser/ui",
    "//chrome/common",
    "//components/download/public/common:public",
    "//components/input",
    "//components/permissions",
    "//components/version_info",
    "//content/public/browser",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//services/device/public/cpp/geolocation",
    "//services/device/public/mojom",
    "//skia",
    "//sql",
    "//third_party/re2",
    "//ui/base",
    "//ui/events:dom_keycode_converter",
    "//components/viz/common",
    "//ui/gfx",
    "//ui/gfx/codec",
    "//ui/gfx/geometry",
    "//ui/snapshot",
  ]

  if (use_aura) {
    deps += [ "//ui/aura" ]
  }

  if (is_mac) {
    frameworks = [ "IOKit.framework" ]
  }
}

source_set("browser_tests") {
  testonly = true
  defines = [ "HAS_OUT_OF_PROC_TEST_RUNNER" ]

  sources = [
    "abp_action_lifecycle_browsertest.cc",
  ]

  deps = [
    ":abp",
    "//base",
    "//base/test:test_support",
    "//chrome/browser",
    "//chrome/test:test_support",
    "//content/public/browser",
    "//content/test:browsertest_support",
    "//content/test:test_support",
    "//net:test_support",
  ]

  if (is_mac) {
    frameworks = [ "IOKit.framework" ]
  }
}
